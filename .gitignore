# ==========================================================
#   GITIGNORE — Root of project
# ==========================================================

# ----------------------------------------------------------
# Node dependencies & package managers
# ----------------------------------------------------------
node_modules/
**/node_modules/

# npm/yarn/pnpm logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ----------------------------------------------------------
# Build outputs
# ----------------------------------------------------------
dist/
build/
out/
.cache/
.vite/
.next/
coverage/
.tmp/

# ----------------------------------------------------------
# Environment and secrets
# ----------------------------------------------------------
.env
.env.*
!.env.example             # keep safe template version for devs
!.frontend/.env.example
!.backend/.env.example

# AWS & credentials
.aws/
.cdk.out/
*.pem
*.crt
*.key
*.p12
*.csr
*.der

# ----------------------------------------------------------
# System / Editor / OS files
# ----------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*.bak
*.orig
*.tmp

# ----------------------------------------------------------
# Logs & runtime
# ----------------------------------------------------------
*.log
logs/
*.pid
*.seed
*.pid.lock
debug.log
error.log

# ----------------------------------------------------------
# TypeScript / Compiler artifacts
# ----------------------------------------------------------
*.tsbuildinfo
*.d.ts.map

# ----------------------------------------------------------
# Testing / Coverage
# ----------------------------------------------------------
coverage/
*.lcov
jest-results.json

# ----------------------------------------------------------
# Lockfiles (keep the real ones next to package.json)
# ----------------------------------------------------------
# DO NOT ignore package-lock.json files in app folders
# Uncomment if using yarn/pnpm instead of npm:
# yarn.lock
# pnpm-lock.yaml

# ----------------------------------------------------------
# Frontend specific
# ----------------------------------------------------------
frontend/dist/
frontend/.cache/
frontend/.env.local
frontend/.env.development.local
frontend/.env.production.local
frontend/.env.test.local

# ----------------------------------------------------------
# Backend specific
# ----------------------------------------------------------
backend/dist/
backend/.env.local
backend/.env.development.local
backend/.env.production.local
backend/.env.test.local
backend/logs/
backend/tmp/

# ----------------------------------------------------------
# Misc / Tooling
# ----------------------------------------------------------
*.sqlite
*.db
*.db-journal
*.tgz
*.tar.gz

# Temporary scratch or export files
tmp/
export/
uploads/
