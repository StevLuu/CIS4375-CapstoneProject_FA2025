generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

model category {
  category_id        Int             @id @default(autoincrement())
  category_name      String          @db.VarChar(255)
  parent_category_id Int?
  category           category?       @relation("categoryTocategory", fields: [parent_category_id], references: [category_id], onUpdate: NoAction)
  other_category     category[]      @relation("categoryTocategory")
  category_item      category_item[]

  @@index([parent_category_id], map: "idx_category_parent")
}

model category_item {
  category_id Int
  sku         String   @db.VarChar(50)
  user_id     Int
  category    category @relation(fields: [category_id], references: [category_id], onDelete: Cascade, onUpdate: NoAction)
  item        item     @relation(fields: [sku, user_id], references: [sku, user_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([category_id, sku, user_id])
  @@index([category_id], map: "idx_category_item_cat")
  @@index([sku, user_id], map: "idx_category_item_item")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model item {
  sku                           String          @db.VarChar(50)
  user_id                       Int
  reference_handle              String?         @db.VarChar(150)
  token                         String?         @db.VarChar(50)
  item_name                     String          @db.VarChar(150)
  variation_name                String?         @db.VarChar(100)
  description                   String?
  seo_title                     String?         @db.VarChar(255)
  seo_description               String?
  permalink                     String?         @db.VarChar(255)
  gtin                          String?         @db.VarChar(50)
  square_online_item_visibility String?         @default("visible") @db.VarChar(20)
  item_type                     String?         @db.VarChar(50)
  social_media_link_title       String?         @db.VarChar(255)
  social_media_link_description String?
  shipping_enabled              String?         @default("N") @db.Char(1)
  self_serve_ordering           String?         @default("N") @db.Char(1)
  delivery_enabled              String?         @default("N") @db.Char(1)
  pickup_enabled                String?         @default("N") @db.Char(1)
  price                         Decimal?        @db.Decimal(10, 2)
  online_sale_price             Decimal?        @db.Decimal(10, 2)
  archived                      String?         @default("N") @db.Char(1)
  sellable                      String?         @default("Y") @db.Char(1)
  contains_alcohol              String?         @default("N") @db.Char(1)
  stockable                     String?         @default("Y") @db.Char(1)
  skip_detail_screen_in_pos     String?         @default("N") @db.Char(1)
  option_name_1                 String?         @db.VarChar(100)
  option_value_1                String?         @db.VarChar(100)
  current_quantity              Int?            @default(0)
  new_quantity                  Int?
  stock_alert_enabled           String?         @default("N") @db.Char(1)
  stock_alert_count             Int?
  modifier                      String?         @db.VarChar(100)
  category_item                 category_item[]
  user                          user            @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  log_item                      log_item[]

  @@id([sku, user_id])
  @@index([user_id], map: "idx_item_user")
}

model log {
  log_id    Int        @id @default(autoincrement())
  timestamp DateTime   @default(now()) @db.Timestamp(6)
  user_id   Int
  type      String?    @db.VarChar(100)
  user      user       @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  log_item  log_item[]

  @@index([user_id, timestamp], map: "idx_log_user_ts")
}

model log_item {
  log_id   Int
  sku      String @db.VarChar(50)
  user_id  Int
  quantity Int    @default(0)
  log      log    @relation(fields: [log_id], references: [log_id], onDelete: Cascade, onUpdate: NoAction)
  item     item   @relation(fields: [sku, user_id], references: [sku, user_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([log_id, sku, user_id])
  @@index([sku, user_id], map: "idx_log_item_item")
  @@index([log_id], map: "idx_log_item_log")
}

model user {
  user_id         Int      @id @default(autoincrement())
  squareUsername  String?  @map("username") @db.VarChar(255)
  password        String   @db.VarChar(255)
  email           String   @unique @db.Citext
  created_at      DateTime @default(now()) @db.Timestamp(6)
  updated_at      DateTime @default(now()) @db.Timestamp(6)
  item            item[]
  log             log[]

  @@map("user")
}

